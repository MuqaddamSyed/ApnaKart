# Copy to .env and fill in. .env is bundled as a Flutter asset (see pubspec.yaml).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_KEY
FCM_SERVER_KEY=YOUR_FCM_SERVER_KEY

# App Store / Play reviewer login bypass. Leave BLANK to disable the bypass
# entirely (dev builds). Fill all three only in the store-submission build,
# and create the matching demo account in Supabase (see store/DEMO_ACCOUNT_SETUP.md).
# Choose a FRESH password — do not reuse any value from git history.
REVIEWER_EMAIL=
REVIEWER_CODE=
REVIEWER_PASSWORD=
