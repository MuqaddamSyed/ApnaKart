# Release signing config. Copy to android/key.properties (gitignored) to sign
# release builds with your own keystore instead of the debug key.
#
# 1. Generate a keystore once (keep the .jks and passwords safe — losing them
#    means you can never update the app again):
#
#    keytool -genkey -v -keystore android/app/release.jks \
#      -keyalg RSA -keysize 2048 -validity 10000 -alias quickkart
#
# 2. Copy this file to android/key.properties and fill in the values below.
# 3. `flutter build apk --release --flavor <customer|supplier|delivery> -t <entrypoint>`
#    will now be signed with your release key.
#
# NOTE: the FIRST install after switching from the debug key to this release
# key requires uninstalling the old app once (different signature). Every
# update after that installs in place.

storeFile=release.jks
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=quickkart
